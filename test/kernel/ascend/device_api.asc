/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * FlagCX Device API kernels — Ascend (CANN).
 *
 * Stage 2 content is deliberately narrow: it is the toolchain smoke gate, not
 * the acceptance suite. What this file has to prove, measured on Ascend 910C
 * (soc Ascend910_9382, __NPU_ARCH__ 2201, CANN 9.1.0-beta.3):
 *   1. FlagCX's Device API headers instantiate on the bisheng aicore pass —
 *      the include set below is the same one the reference vendor kernels
 *      use, so anything that breaks here breaks for the stage-3 port too;
 *   2. a device translation unit built from the Ascend platform traits links
 *      into libflagcx without a separate device-link step;
 *   3. block-scope scratch through __ubuf__ reaches global memory, and a
 *      by-value struct carrying unqualified pointers really addresses it: a
 *      kernel launched from the host half of a translation unit stored 10 and
 *      11 through such a member and aclrtMemcpy read them back (probe RP,
 *      "OUT 10 11 0 0").
 *
 * What this file does NOT contain, on purpose: no plain-pointer ordered
 * access, no read-modify-write, no block barrier. CceAtomic's PLAIN load and
 * store and every RMW member stay declared-absent capabilities on this pass —
 * the volatile accesses that load/store used to be do not provide the acquire
 * or release that default_comm_traits.h asks for (:574 AcqRel, :580 Acquire,
 * :858 Release), and the review decision on PR #705 (2026-11-10) was to state
 * that as unsupported here rather than ship an ordered-looking unordered
 * access. Naming an absent member here would leave a reference to a function
 * that is declared and never defined in the gate object, and bisheng links the
 * device image inside -c, so the gate itself would stop building — which is
 * the behaviour a stage-3 kernel must not be able to paper over.
 *
 * What this file DOES contain since 2026-11-11: the ordered version, because
 * it has now been verified on hardware. A two-core producer/consumer
 * rendezvous built from store + asc_dcci_entire_out (release) and
 * asc_dcci_entire_all + volatile load (acquire), one cache line per slot,
 * passed 40/40 forced-race runs on this soc (see the record in
 * ascend_platform_traits.h and the PR #705 comment "Two-core ordered round
 * trip"). flagcxDevApiOrderedSmoke below instantiates exactly that surface —
 * the __gm__ load/store overloads and the two-call device fence — through
 * FlagCX's own traits, so the gate object proves the wiring builds and links;
 * its cross-core behaviour is measured by the rendezvous rig, not claimed by
 * this single-core kernel. RC=0 alone was never treated as synchronization:
 * that lesson is what the 40-run gate exists for.
 *
 * The T1-T4 kernel set (intra-node AllReduce over IPC peer pointers, inter-node
 * put/signal/flush, the eight one-sided facets) is stage 3; it arrives as a
 * port of the reference implementation, whose body is already written against
 * the FLAGCX_* macros in device_utils.h rather than against vendor builtins.
 *
 * Nothing here claims a capability the platform does not have: there is no
 * warp/lane code (Ascend 910C rejects the SIMT entry model, see the note in
 * device_utils.h), no block barrier and no read-modify-write; the fence and
 * the load/store the smoke kernel uses are the measured dcci pair, claimed
 * only within its documented envelope (device scope, single chip, __gm__
 * end to end).
 ************************************************************************/

#include "device_api/flagcx_device.h"
#include "ascend_adaptor.h"
#include "flagcx_kernel.h"
#include "global_comm.h"

// Datatype size helper, shared shape with the other vendor test kernels.
FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    default:
      return 0;
  }
}

// Toolchain smoke: __ubuf__ staging buffer -> global memory. Runs on one AI
// core; the value it writes is what the stage gate checks. This kernel is the
// one place where a __gm__ parameter is legitimate: it is written through
// directly, and never converted to a plain pointer.
extern "C" __global__ __aicore__ void flagcxDevApiSmoke(__gm__ uint32_t *out,
                                                        uint32_t value) {
  FLAGCX_SHARED uint32_t stage[1];
  stage[0] = value;
  out[0] = stage[0];
}

#if defined(__CCE_IS_AICORE__)
// Ordering wiring smoke: instantiate the hardware-verified ordered surface —
// CceAtomic's __gm__ load/store overloads and the two-call device fence —
// through FlagCX's own platform traits, so the gate object proves the wiring
// compiles and links into libflagcx's device image. Single core, no peer:
// this kernel demonstrates the API shape only; the cross-core semantics of
// the identical spelling are measured by the two-core rendezvous rig (40/40,
// 2026-11-11; envelope documented in ascend_platform_traits.h). Slots sit 32
// words (one 128B line) apart exactly as the protocol requires. Never
// launched by anything today; a future stage-3 test will.
extern "C" __global__ __aicore__ void flagcxDevApiOrderedSmoke(
    __gm__ uint32_t *out, uint32_t value) {
  using AscendCce = PlatformTraits<AscendPlatform>::CceAtomic;
  AscendCce::store(out, value);            // release: store + entire_out
  AscendCce::store(out + 32u, 7u);         // second line, second publish
  FLAGCX_DEVICE_THREAD_FENCE();            // entire_out + entire_all
  uint32_t a = AscendCce::load(out);       // acquire: entire_all + load
  uint32_t b = AscendCce::load(out + 32u);
  AscendCce::store(out + 64u, a + b);      // third line: observed sum
}
#endif  // __CCE_IS_AICORE__
