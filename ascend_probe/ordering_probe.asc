/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Round-62 compile matrix: how does the measured handshake (rows 60/61:
 * release = store + asc_dcci_entire_out; acquire = asc_dcci_entire_all +
 * volatile load, 40/40 rendezvous) BIND to the pointer types that
 * CceAtomic's shared signatures actually carry? Kernel signatures may
 * not take plain pointers at all (v6, declaration-level), so the whole
 * question lives in helper-function conversions:
 *   F1  kernel __gm__ param -> plain-param helper   (implicit gm->plain)
 *   F2  __gm__ volatile helpers, no casts at all    (target shape)
 *   F3  C-cast gm->plain in kernel, then plain helper (explicit gm->plain)
 *   F4  uintptr_t round trip gm->int->gm            (escape hatch)
 *   F5  plain-param helper that converts plain->__gm__ INTERNALLY and
 *       only dereferences the gm pointer  (the cheap-port hope:
 *       CceAtomic keeps its plain signatures, converts inside)
 * Compile-only (-c): this decides the traits diff shape, not semantics.
 * Semantics were measured on hardware in rows 60/61 with __gm__ direct.
 ************************************************************************/
#include <stdint.h>
#include "c_api/cache_ctrl/cache_ctrl.h"

#if FORM == 1 || FORM == 3
__aicore__ inline uint32_t acq_load(const uint32_t *p) {
  asc_dcci_entire_all();
  return *p;
}
__aicore__ inline void rel_store(uint32_t *p, uint32_t v) {
  *p = v;
  asc_dcci_entire_out();
}
#endif

#if FORM == 2 || FORM == 4
__aicore__ inline uint32_t acq_load_g(__gm__ const volatile uint32_t *p) {
  asc_dcci_entire_all();
  return *p;
}
__aicore__ inline void rel_store_g(__gm__ volatile uint32_t *p, uint32_t v) {
  *p = v;
  asc_dcci_entire_out();
}
#endif

#if FORM == 5
__aicore__ inline uint32_t acq_load_pc(const uint32_t *p) {
  __gm__ const volatile uint32_t *g =
      (__gm__ const volatile uint32_t *)(uintptr_t)(p);
  asc_dcci_entire_all();
  return *g;
}
__aicore__ inline void rel_store_pc(uint32_t *p, uint32_t v) {
  __gm__ volatile uint32_t *g = (__gm__ volatile uint32_t *)(uintptr_t)(p);
  *g = v;
  asc_dcci_entire_out();
}
#endif

extern "C" __global__ __aicore__ void fprobe(__gm__ uint32_t *g) {
#if FORM == 1
  rel_store(g, 1u);
  uint32_t v = acq_load(g);
  if (v == 2u) {
    g[96] = v;
  }
#elif FORM == 2
  rel_store_g(g, 1u);
  uint32_t v = acq_load_g(g);
  if (v == 2u) {
    g[96] = v;
  }
#elif FORM == 3
  uint32_t *p = (uint32_t *)g;
  rel_store(p, 1u);
  uint32_t v = acq_load(p);
  if (v == 2u) {
    g[96] = v;
  }
#elif FORM == 4
  uintptr_t a = (uintptr_t)g;
  rel_store_g((__gm__ volatile uint32_t *)a, 1u);
  uint32_t v = acq_load_g((__gm__ const volatile uint32_t *)a);
  if (v == 2u) {
    g[96] = v;
  }
#elif FORM == 5
  rel_store_pc(g, 1u);
  uint32_t v = acq_load_pc(g);
  if (v == 2u) {
    g[96] = v;
  }
#endif
}
