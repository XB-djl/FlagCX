/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core GM-handshake block barrier - round 68 probe.
 * Candidate spelling for FLAGCX_DEVICE_SYNC_THREADS() / namedBarrierSync
 * on Ascend: a real barrier built ONLY from the ordered channel already
 * measured 40/40 (release = store + asc_dcci_entire_out; acquire =
 * asc_dcci_entire_all + volatile __gm__ read). The ffts route stays
 * archived (wait_flag_dev hangs, arrive faults 507015).
 *
 * What makes this a BARRIER and not another rendezvous: every round each
 * core publishes a WORK payload BEFORE its arrival flag, and after
 * crossing the gate re-reads the peer's work line - a stale work value
 * after a seen arrival is an ordering violation (the V counters below),
 * exactly the happens-before property namedBarrierSync must promise.
 *
 * Protocol, rounds r = 1..20 (both cores run the identical loop; roles
 * by asc_get_block_idx):
 *   p[work]  = r;              flush          (pre-barrier payload)
 *   p[arv]   = r;              flush          (arrival)
 *   while (spins < 20000 && volatile q[peer_arv] < r) { entire_all; ++spins }
 *   exhausted -> degrade count++ (never deadlock; same discipline as R1)
 *   else if (volatile q[peer_work] < r) -> ordering-violation count++
 *   (the last poll hammered all of L1, so the work read refetches from GM
 *   - same read-after-final-hammer shape R1 measured 40/40)
 * Monotonic counters + >= wait: no lost-wakeup on skew; each core keeps
 * one line per slot (128B apart), as the protocol requires.
 *
 * Slots (word index = 32*line), one 1536 B host-zeroed GM buffer:
 *   L0 ar0  L1 ar1  L2 w0  L3 w1  L4 deg0  L5 deg1
 *   L6 mx0  L7 mx1  L8 vio0  L9 vio1
 * Output per run: SYNC_RC, then "BR F u u S u u V u u" (degrades, max
 * spins, violations - core0 first). PASS matrix (pre-registered before
 * the run): 10/10 runs F=0 0, V=0 0, SYNC_RC=0, and >=8/10 with
 * S0+S1>0 (genuine waits; a zero-spin run is the legitimate racing-ahead
 * state recorded honestly, symmetric pair, as PS=0/SP=0 were in r61/r63).
 * Negative control arm -DBR_NO_INV: poll without the per-poll invalidate
 * must stick on the cached line and exhaust BOTH cores (predicted
 * F=20 20, V=0 0 because violation counting is gated on crossing -
 * the signature is exhaustion, not stale reads).
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

#define L_AR0 0u
#define L_AR1 32u
#define L_W0 64u
#define L_W1 96u
#define L_F0 128u
#define L_F1 160u
#define L_S0 192u
#define L_S1 224u
#define L_V0 256u
#define L_V1 288u
#define NROUNDS 20u
#define SPIN_MAX 20000u

extern "C" __global__ __aicore__ void bar2(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  const uint32_t AR = (b == 0) ? L_AR0 : L_AR1;
  const uint32_t PA = (b == 0) ? L_AR1 : L_AR0;
  const uint32_t WK = (b == 0) ? L_W0 : L_W1;
  const uint32_t PW = (b == 0) ? L_W1 : L_W0;
  const uint32_t FG = (b == 0) ? L_F0 : L_F1;
  const uint32_t SG = (b == 0) ? L_S0 : L_S1;
  const uint32_t VG = (b == 0) ? L_V0 : L_V1;
  volatile __gm__ uint32_t *q = p;
  uint32_t deg = 0, mx = 0, vio = 0;
  for (uint32_t r = 1u; r <= NROUNDS; ++r) {
    p[WK] = r;
    asc_dcci_entire_out();
    p[AR] = r;
    asc_dcci_entire_out();
    uint32_t sp = 0;
#ifdef BR_NO_INV
    while (sp < SPIN_MAX && q[PA] < r) {
      ++sp;
    }
#else
    while (sp < SPIN_MAX && q[PA] < r) {
      asc_dcci_entire_all();
      ++sp;
    }
#endif
    if (sp >= SPIN_MAX) {
      ++deg;  /* degrade, never deadlock */
    } else if (q[PW] < r) {
      ++vio;  /* crossed on arrival but work stale = barrier broken */
    }
    if (sp > mx) mx = sp;
  }
  p[FG] = deg;
  p[SG] = mx;
  p[VG] = vio;
  asc_dcci_entire_out();
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 1536, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 1536, 0, 1536) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  bar2<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t w[384];
  for (int i = 0; i < 384; ++i) w[i] = 9u;
  int mr = aclrtMemcpy(w, 1536, d, 1536, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("BR F %u %u S %u %u V %u %u\n", w[L_F0], w[L_F1],
         w[L_S0], w[L_S1], w[L_V0], w[L_V1]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
