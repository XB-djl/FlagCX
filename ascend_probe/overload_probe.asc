/*************************************************************************
 * Round-66 arm P (v2 of the round-65 binding probe).
 *
 * v1 lesson, measured: the P1/P2 failures at lines 51/56 were NOT overload
 * binding - they were parse-time diagnostics for calling asc_dcci_* from
 * plain `static inline` members. The CCE intrinsics require the CALLER to
 * carry __aicore__ (real traits members are FLAGCX_DEVICE_INLINE_DECORATOR
 * = `__aicore__ inline`, device_utils.h:372). v2 mirrors that decorator,
 * guards the whole surface with __CCE_IS_AICORE__ (host pass gets an empty
 * TU), and adds the plain-call controls. Expectations per arm (predictions
 * stated BEFORE the run, so a surprise is information):
 *   P1 store(gm, u32)  with gm overloads: RC=0  (gm overload binds; body
 *                      is dcci+mem only - the positive control the r65
 *                      message claimed early)
 *   P2 load(gm)        with gm overloads: RC=0
 *   P3 store(gm, u32)  without gm:        RC=1, text "no matching
 *                      function", TMPL=0 (v1 measured this; re-confirmed
 *                      without the decorator artifact)
 *   P4 load(gm)        without gm:        RC=1, same shape
 *   P5 store(&local,u32) plain:           RC=1, names probePlainTrap -
 *                      the declared-absent trap mechanism alive end to
 *                      end (this is exactly the A1 failure signature)
 *   P6 load(&local) plain:                RC=1, names probePlainTrap
 * Trap bodies call never-defined stubs so the linker names the bound
 * overload. Compile-only; never launched; never linked into libflagcx.
 ************************************************************************/
#if defined(__CCE_IS_AICORE__)
#include "c_api/cache_ctrl/cache_ctrl.h"

extern "C" void probePlainTrap();
extern "C" void probeTmplTrap();

struct Probe {
  // Mirrors the plain declared-absent members (uint32 slice), decorated.
  static __aicore__ inline uint32_t load(const uint32_t *p) {
    (void)p;
    probePlainTrap();
    return 0u;
  }
  static __aicore__ inline void store(uint32_t *p, uint32_t v) {
    (void)p;
    (void)v;
    probePlainTrap();
  }
#ifndef PROBE_NO_GM
  // Mirrors the NEW __gm__ overloads, measured spelling verbatim.
  static __aicore__ inline uint32_t load(__gm__ const volatile uint32_t *p) {
    asc_dcci_entire_all();
    return *p;
  }
  static __aicore__ inline void store(__gm__ volatile uint32_t *p, uint32_t v) {
    *p = v;
    asc_dcci_entire_out();
  }
#endif
  // Mirrors the catch-all templates, deduction shapes identical.
  template <typename T>
  static __aicore__ inline T load(const T *p) {
    (void)p;
    probeTmplTrap();
    return T();
  }
  template <typename T>
  static __aicore__ inline void store(T *p, const T &v) {
    (void)p;
    (void)v;
    probeTmplTrap();
  }
};

extern "C" __global__ __aicore__ void probeKernel(__gm__ uint32_t *out,
                                                  uint32_t value) {
#if defined(PROBE_OP_STORE)
  Probe::store(out, value);
#elif defined(PROBE_OP_LOAD)
  uint32_t x = Probe::load(out);
  out[64u] = x;  // sink keeps the load alive; plain __gm__ write, kernel-legal
#elif defined(PROBE_OP_PSTORE)
  uint32_t local = value;
  Probe::store(&local, 7u);  // plain pointer to stack - historically legal
  out[64u] = local;
#elif defined(PROBE_OP_PLOAD)
  uint32_t local = value;
  out[64u] = Probe::load(&local);
#else
#error "define PROBE_OP_STORE / PROBE_OP_LOAD / PROBE_OP_PSTORE / PROBE_OP_PLOAD"
#endif
}
#endif  // __CCE_IS_AICORE__
