/*************************************************************************
 * Round-67 arm P (v3 of the binding probe).
 *
 * Lineage, all measured: v1 members lacked __aicore__, so asc_dcci_* inside
 * their bodies failed at PARSE time (caller-qualification rule) and v1's
 * "no matching function" rejections at the call sites were that same rule,
 * NOT address-space evidence - the round-65 reading of P3/P4 is retracted.
 * v2 fixed the members but not the stubs: `extern "C" void probePlainTrap()`
 * without __aicore__ is uncalled-able from __aicore__ members, so all six
 * v2 arms died at :37/:43 before measuring anything (third probe, same
 * rule, own goal). v3 decorates the stubs exactly like the real never-
 * defined externs in device_utils.h (`extern "C" FLAGCX_DEVICE_DECORATOR`),
 * so a bound trap surfaces as the LINK error this whole saga started from.
 *
 * The probe's overload set mirrors the PRE-fix traits (templates present);
 * -DPROBE_NO_TMPL removes the catch-alls to mirror the POST-fix shape.
 * Predictions stated BEFORE the run (a surprise is the information):
 *   P1 store(gm,u32) pre-fix set:       RC=0  (B1 green reproduced in
 *                      isolation - store template blocked by the deduction
 *                      conflict on its const T& value parameter)
 *   P2 load(gm)      pre-fix set:       RC=1, link error naming
 *                      probeTmplTrap - THE minimal reproduction of B2
 *                      (load template deduces T=__gm__ uint32_t and beats
 *                      the non-template ordered overload on bisheng)
 *   P3 store(gm,u32) no gm overloads:   RC=1, "no matching function"
 *   P4 load(gm)      no gm overloads:   RC=1, names probeTmplTrap (the
 *                      swallow measured with nothing ordered competing)
 *   P5/P6 plain calls:                  RC=1, link error naming
 *                      probePlainTrap (declared-absent mechanism control,
 *                      same signature class as the r64/r65 gate failure)
 *   P7 load(gm)  no templates (fixed):  RC=0  (fix-shape control: the
 *                      gm overload binds unopposed and the body links)
 *   P8 store(gm,u32) no templates:      RC=0
 * Compile-only; never launched; never linked into libflagcx.
 ************************************************************************/
#if defined(__CCE_IS_AICORE__)
#include "c_api/cache_ctrl/cache_ctrl.h"

extern "C" __aicore__ void probePlainTrap();
extern "C" __aicore__ void probeTmplTrap();

struct Probe {
  // Mirrors the plain declared-absent members (uint32 slice), decorated.
  static __aicore__ inline uint32_t load(const uint32_t *p) {
    (void)p;
    probePlainTrap();
    return 0u;
  }
  static __aicore__ inline void store(uint32_t *p, uint32_t v) {
    (void)p;
    (void)v;
    probePlainTrap();
  }
#ifndef PROBE_NO_GM
  // Mirrors the __gm__ overloads, measured spelling verbatim.
  static __aicore__ inline uint32_t load(__gm__ const volatile uint32_t *p) {
    asc_dcci_entire_all();
    return *p;
  }
  static __aicore__ inline void store(__gm__ volatile uint32_t *p, uint32_t v) {
    *p = v;
    asc_dcci_entire_out();
  }
#endif
  // Mirrors the RMW-style catch-all deduction shapes (load/store variants
  // are REMOVED from the real traits as of 04acc20; kept here precisely so
  // P2 can reproduce B2 and P4 can measure what removing them prevented).
  // PROBE_NO_TMPL mirrors the POST-fix overload set.
#ifndef PROBE_NO_TMPL
  template <typename T>
  static __aicore__ inline T load(const T *p) {
    (void)p;
    probeTmplTrap();
    return T();
  }
  template <typename T>
  static __aicore__ inline void store(T *p, const T &v) {
    (void)p;
    (void)v;
    probeTmplTrap();
  }
#endif  // PROBE_NO_TMPL
};

extern "C" __global__ __aicore__ void probeKernel(__gm__ uint32_t *out,
                                                  uint32_t value) {
#if defined(PROBE_OP_STORE)
  Probe::store(out, value);
#elif defined(PROBE_OP_LOAD)
  uint32_t x = Probe::load(out);
  out[64u] = x;  // sink keeps the load alive; plain __gm__ write, kernel-legal
#elif defined(PROBE_OP_PSTORE)
  uint32_t local = value;
  Probe::store(&local, 7u);  // plain pointer to stack - historically legal
  out[64u] = local;
#elif defined(PROBE_OP_PLOAD)
  uint32_t local = value;
  out[64u] = Probe::load(&local);
#else
#error "define PROBE_OP_STORE / PROBE_OP_LOAD / PROBE_OP_PSTORE / PROBE_OP_PLOAD"
#endif
}
#endif  // __CCE_IS_AICORE__
