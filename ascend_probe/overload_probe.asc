/*************************************************************************
 * Round-65 arm A4: which overload does a __gm__ argument actually BIND to
 * on bisheng clang 15 in -x asc mode? The r64 fresh gate compile died at
 * the in -c device link with undefined flagcxAscendDeviceOpUnsupported
 * .cube/.vector - a trap body got instantiated. Leading hypothesis: the
 * catch-all templates in CceAtomic (ascend_platform_traits.h:479/485,
 * shapes mirrored verbatim below) deduced THROUGH the __gm__ address
 * space and won the overload resolution against the new non-template
 * __gm__ overloads, even though the standard says a tied non-template
 * must win. This file decides it by measurement: trap bodies call
 * never-defined stubs, so the linker names the overload that was bound
 * (probeTmplTrap = catch-all template; probePlainTrap = plain-absent
 * member). Compile-only; nothing here is ever launched or linked into
 * libflagcx.
 *
 * Configs, selected with -D (all four run by build_run.sh v15):
 *   -DPROBE_OP_STORE        kernel body: Probe::store(out, value)
 *   -DPROBE_OP_LOAD         kernel body: x = Probe::load(out)
 *   -DPROBE_NO_GM           omit the __gm__ overloads, so the template
 *                           is either bound (trap undefined) or rejected
 *                           ("no matching function") - the text tells
 *                           which, and whether the gm overload was doing
 *                           the winning at all.
 *
 * Fidelity limit, recorded honestly: members here are plain `static
 * inline`, not FLAGCX_DEVICE_INLINE_DECORATOR-qualified, and the plain
 * traps are direct stub calls rather than the noOrderedLoad<T> indirection.
 * Neither changes overload resolution; if all four arms come back clean,
 * the trigger is NOT this shape and the search moves to the wiring.
 ************************************************************************/
#include "c_api/cache_ctrl/cache_ctrl.h"

extern "C" void probePlainTrap();
extern "C" void probeTmplTrap();

struct Probe {
  // Mirrors the plain declared-absent members (uint32 slice of the set).
  static inline uint32_t load(const uint32_t *p) {
    (void)p;
    probePlainTrap();
    return 0u;
  }
  static inline void store(uint32_t *p, uint32_t v) {
    (void)p;
    (void)v;
    probePlainTrap();
  }
#ifndef PROBE_NO_GM
  // Mirrors the NEW __gm__ overloads, measured spelling verbatim.
  static inline uint32_t load(__gm__ const volatile uint32_t *p) {
    asc_dcci_entire_all();
    return *p;
  }
  static inline void store(__gm__ volatile uint32_t *p, uint32_t v) {
    *p = v;
    asc_dcci_entire_out();
  }
#endif
  // Mirrors the catch-all templates, deduction shapes identical.
  template <typename T>
  static inline T load(const T *p) {
    (void)p;
    probeTmplTrap();
    return T();
  }
  template <typename T>
  static inline void store(T *p, const T &v) {
    (void)p;
    (void)v;
    probeTmplTrap();
  }
};

extern "C" __global__ __aicore__ void probeKernel(__gm__ uint32_t *out,
                                                  uint32_t value) {
#if defined(PROBE_OP_STORE)
  Probe::store(out, value);
#elif defined(PROBE_OP_LOAD)
  uint32_t x = Probe::load(out);
  out[64u] = x;  // sink keeps the load alive; plain __gm__ write, kernel-legal
#else
#error "define PROBE_OP_STORE or PROBE_OP_LOAD"
#endif
}
