/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * deliberately outside every build target and outside the device gate
 * Makefile, so it cannot affect CI or libflagcx.
 *
 * Round-52 result (measured; V1/V2/V3 each built RC=0 — first full
 * device+host+link build — and each run 3 times):
 *   every run: SYNC_FAIL, "OUT 1 0 0 0", and NO host timeout (nothing
 *   exited via `timeout 30`). The producer store reached GM (p[0]=1),
 *   the consumer never reached its completion store (p[2]=0), and the
 *   stream sync ERRED QUICKLY — a device-side abort, not a hang.
 *   Emission (rounds 48-50) is proven; this says the current launch
 *   shape does not order, and the old log cannot separate "consumer
 *   never ran" from "consumer died at wait".
 * Round-53 controls (this file):
 *   1. numeric SYNC_RC + aclGetRecentErrMsg() — the actual failure code.
 *   2. p[3] entry marker: the consumer stores 8 (and flushes) BEFORE
 *      its wait. p[3]=8 with a fault -> died at wait; p[3]=0 -> never ran.
 *   3. V0: two blocks, NO arrive/wait anywhere — pure launch-path
 *      control. If V0 also fails, fence verdicts are moot: the <<<2>>>
 *      path itself cannot host two co-resident blocks.
 *   4. -DCOOP: launch via aclrtLaunchCooperativeKernel(2 blocks /
 *      total 2) — co-residency is what cross-core FFTS events need;
 *      <<<>>> most likely never guarantees it.
 * Variants:
 *   V0  control: stores+flush only, no sync primitives.
 *   V1  signal: core0 store;flush;arrive(ev1).
 *                 core1 mark;flush;wait(ev1);invalidate;load;complete.
 *   V2  barrier-safe: V1 + core1 arrives(ev1) before its wait.
 *   V3  = V1 without the two ORDERING dcci (core0 pre-arrive flush,
 *         core1 post-wait invalidate); final flushes stay so the host
 *         can still read results back.
 *   v1c/v2c = V1/V2 launched cooperatively.
 * Reading (PASS := SYNC_RC=0 AND OUT 1 1 7 8):
 *   v1c or v2c PASS, plain V1/V2 FAIL -> cooperative launch required:
 *        adopt it for FLAGCX_DEVICE_SYNC and the launchKernel slot.
 *   plain V1 PASS as well -> <<<>>> happened to co-schedule this time;
 *        still prefer the cooperative shape (explicit co-residency).
 *   V1 p[3]=8 with a fault -> the wait itself faults: escalate to the
 *        asc_sync_notify/wait family / check the flag-id space, guided
 *        by the round-53 survey block and the SYNC_RC value.
 *   V1 p[3]=0 with a fault -> consumer never ran; scheduling issue.
 *   V0 FAIL -> everything above is moot; fix the launch path first.
 * Shared GM buffer, 16 B, host-zeroed before launch:
 *   p[0] producer payload (1u)      p[1] consumer's observed value
 *   p[2] consumer completion (7u)   p[3] consumer entry marker (8u)
 * Every other shape below is a reuse of an on-record measurement, not an
 * assumption: __gm__ kernel pointer parameter accepted at the launch
 * boundary with an unqualified host pointer (probes B5/RG); the
 * <<<blocks, (void*)0, 0>>> launch and the aclrtMalloc/
 * ACL_MEM_MALLOC_HUGE_FIRST + aclrtMemcpy ACL_MEMCPY_DEVICE_TO_HOST
 * readback are the RP/RG harness verbatim (round 52 re-proved them);
 * asc_get_block_idx() from c_api/sys_var/sys_var.h (round-51 survey);
 * the dcci and FFTS spellings measured RC=0 in rounds 48-50; on 2201
 * asc_sync_block_wait(pipe,flag) expands to wait_flag_dev(flag), the
 * pipe argument being dropped (round 51).
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
    p[0] = 1u;
#ifndef V3
    asc_dcci_entire_out();
#endif
#ifndef V0
    asc_sync_block_arrive(PIPE_M, 1);
#endif
  } else {
    p[3] = 8u;
#ifdef V2
    asc_sync_block_arrive(PIPE_M, 1);
#endif
#ifndef V0
    asc_sync_block_wait(PIPE_M, 1);
#endif
    p[1] = p[0];
    p[2] = 7u;
    asc_dcci_entire_out();
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 16, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 16, 0, 16) != 0) { printf("MEMSET_FAIL\n"); return 1; }
#ifdef COOP
  void *args[] = { (void *)&d };
  int lr = aclrtLaunchCooperativeKernel((const void *)t2c, args, 2, 2, 0,
                                       (aclrtStream)0, false, false);
  printf("COOP_RC=%d\n", lr);
#else
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
#endif
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t h[4] = {9u, 9u, 9u, 9u};
  int mr = aclrtMemcpy(h, 16, d, 16, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("OUT %u %u %u %u\n", h[0], h[1], h[2], h[3]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
