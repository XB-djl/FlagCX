/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * outside every build target and the device gate Makefile.
 *
 * ROUND 60 = GATE PASSED, declared: R1 rendezvous 10/10 with
 * SYNC_RC=0, OUT 1 1 7 8, SP 2..8, PS 5..9 — both cores forced into
 * real spin loops every single run; C0 controls stayed green (5th
 * confirmation). Sync-audit checklist pass found no red lines
 * (protocol touches no FFTS ids at all — SYNC-07 free by construction;
 * bounded spins + producer publishes even on exhaustion = degrade-to-
 * stale, never deadlock). Two assumptions documented:
 *   (a) same-core dcci flushes land in GM in issue order (anchor of
 *       payload-before-doorbell visibility; consistent with 40+ runs);
 *   (b) asc_dcci_entire_all()'s treatment of DIRTY lines was never hit
 *       by prior variants (they flush before every hammer). D1 probes
 *       it directly: store 5u dirty, never flushed, entire_all, then
 *       volatile read back — 5 means clean-and-keep semantics,
 *       0 means discard. Implementation rule either way stands:
 *       flush-before-acquire discipline.
 * Round 61: R1 x30 soak + D1 x5 + C0 x2.
 * Primitive under test (all prior rounds' evidence chain in
 * progress_report.md rows 48-60):
 *   release: store -> asc_dcci_entire_out -> doorbell -> flush
 *   acquire: loop { asc_dcci_entire_all; volatile __gm__ load }
 * Shared GM buffer, 1536 B, host-zeroed, one 128B line per slot
 * (slot w-index = 32*i):
 *   w[0] payload(1u)   w[32] observed   w[64] completion(7u)
 *   w[96] entry mark(8u)  w[128] doorbell(1u)  w[160] consumer spins
 *   w[192] READY(1u)      w[224] producer spins
 *   w[256] dirty probe(5u) w[288] dirty readback (D1 only)
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

#define SLOT0 0u
#define SLOT1 32u
#define SLOT2 64u
#define SLOT3 96u
#define SLOT4 128u
#define SLOT5 160u
#define SLOT6 192u
#define SLOT7 224u
#define SLOT8 256u
#define SLOT9 288u
#define SPIN_MAX 20000u

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
#ifdef R1
    volatile __gm__ uint32_t *q = p;
    uint32_t pspins = 0;
    while (pspins < SPIN_MAX && q[SLOT6] != 1u) {
      asc_dcci_entire_all();
      ++pspins;
    }
    p[SLOT0] = 1u;
    asc_dcci_entire_out();
    p[SLOT4] = 1u;
    asc_dcci_entire_out();
    p[SLOT7] = pspins;
    asc_dcci_entire_out();
#else
    p[SLOT0] = 1u;
    asc_dcci_entire_out();
#endif
  } else {
    p[SLOT3] = 8u;
    asc_dcci_entire_out();
#ifdef D1
    /* dirty-semantics probe: 5u written, NEVER flushed by its own
     * store; the hammer below decides clean-vs-discard by what the
     * volatile reload and the final GM value show. */
    p[SLOT8] = 5u;
    asc_dcci_entire_all();
    volatile __gm__ uint32_t *q = p;
    p[SLOT9] = q[SLOT8];
    p[SLOT2] = 7u;
    asc_dcci_entire_out();
#elif defined(R1)
    p[SLOT6] = 1u;
    asc_dcci_entire_out();
    volatile __gm__ uint32_t *q = p;
    uint32_t spins = 0;
    while (spins < SPIN_MAX && q[SLOT4] != 1u) {
      asc_dcci_entire_all();
      ++spins;
    }
    p[SLOT1] = q[SLOT0];
    p[SLOT2] = 7u;
    p[SLOT5] = spins;
    asc_dcci_entire_out();
#else
    p[SLOT1] = p[SLOT0];
    p[SLOT2] = 7u;
    asc_dcci_entire_out();
#endif
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 1536, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 1536, 0, 1536) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t w[384];
  for (int i = 0; i < 384; ++i) w[i] = 9u;
  int mr = aclrtMemcpy(w, 1536, d, 1536, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("OUT %u %u %u %u\n", w[0], w[32], w[64], w[96]);
  printf("DL %u SP %u PS %u\n", w[128], w[160], w[224]);
  printf("DS %u DE %u\n", w[256], w[288]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
