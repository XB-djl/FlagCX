/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * outside every build target and the device gate Makefile.
 *
 * Round-55 measured (all three of C0/F1/F3 built RC=0):
 *   - F3 (wait, nobody ever arrives): EXIT=124 x3 under `timeout 25`.
 *     asc_sync_block_wait is a REAL wait — it never passes unanswered.
 *     So the flag machinery is semantically live; r53's blocker narrows
 *     to exactly one thing: the SET/arrive spelling that currently
 *     faults (507015) — a spelling problem, not an architecture gap.
 *   - F1 (asc_sync_notify/wait 3-arg): compiled RC=0 WITH warning
 *     "use type 'event_t' for the 3rd parameter [-Wcce-compat]" (x2),
 *     then faulted 3/3 as "fftsplus AIVECTOR error" with pc in the
 *     0x1240000000a0 range — a DIFFERENT address space from r53's
 *     aicore faults (0x12c0812...). The literal 1 was encoded as an
 *     illegal event id, executed on the vector side.
 *   - C0 (control): 2 runs "OUT 1 1 7 8", run 3 "OUT 1 1 7 0" —
 *     p[3] vanished although the consumer demonstrably completed.
 *     Diagnosis: all four slots shared ONE 128-byte cache line; each
 *     core's L1 holds other cores' fields as a stale full-line copy,
 *     and asc_dcci_entire_out() writebacks trample each other
 *     line-wide. (r53's "OUT 1 0 7 8" race sighting may partly be
 *     this too — the ordering DEMAND stands, but slot-level
 *     observation requires per-line slots, fixed here.)
 * This round: slots are 128 B apart (one exclusive cache line each).
 * PASS remains SYNC_RC=0 AND OUT 1 1 7 8. Expectation: C0 stable now
 * (if it still flickers, the remaining suspect is MIX execution —
 * build_run.sh dumps readelf device sections for that verdict).
 * F1 keeps the wrong-id spelling on purpose this round: the fault
 * signature vs the fixed layout is still informative; the corrected
 * event_t spelling comes after the sync_impl/ subdir dump is read.
 * Shared GM buffer, 512 B, host-zeroed; slot i at byte 128*i:
 *   w[0] producer payload (1u)      w[32] consumer's observed value
 *   w[64] consumer completion (7u)  w[96] consumer entry marker (8u)
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

#define SLOT0 0u
#define SLOT1 32u
#define SLOT2 64u
#define SLOT3 96u

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
    p[SLOT0] = 1u;
    asc_dcci_entire_out();
#ifdef F1
    asc_sync_notify(PIPE_M, PIPE_M, 1);
#endif
  } else {
    p[SLOT3] = 8u;
    asc_dcci_entire_out();
#ifdef F1
    asc_sync_wait(PIPE_M, PIPE_M, 1);
    asc_dcci_entire_all();
#elif defined(F3)
    asc_sync_block_wait(PIPE_M, 1);
    asc_dcci_entire_all();
#endif
    p[SLOT1] = p[SLOT0];
    p[SLOT2] = 7u;
    asc_dcci_entire_out();
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 512, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 512, 0, 512) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t w[128];
  for (int i = 0; i < 128; ++i) w[i] = 9u;
  int mr = aclrtMemcpy(w, 512, d, 512, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("OUT %u %u %u %u\n", w[0], w[32], w[64], w[96]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
