/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * outside every build target and the device gate Makefile.
 *
 * Round-59 measured — THE POLLING LINE IS ALIVE (volatile retry won):
 *   H2 (volatile poll, no invalidate): r1 r2 SP=0 (producer raced ahead,
 *     cold read hits fresh GM), r3 SP=20000 (consumer entered the loop
 *     BEFORE the doorbell write — L1 cached the 0 and volatile re-reads
 *     kept hitting the stale own-core line: forever blind without
 *     invalidation). That is the negative control: invalidate is
 *     NECESSARY.
 *   H3 (volatile poll + asc_dcci_entire_all per spin): r1 r2 SP=0,
 *     r3 SP=1 — read 0, ONE invalidate, re-read, saw 1, broke out.
 *     That is the mechanism proof: post-invalidate reload fetches fresh
 *     GM data. Invalidate is SUFFICIENT.
 *   Also settled: r57/r58's twelve-blinds were partly compiler hoisting
 *     (side-effect-free loop bodies) and asc_dcci_single (single-line)
 *     does nothing for later reads — wrong tool, whole-L1 is what works.
 *   All six OUTs 1 1 7 8: release order payload->flush->doorbell->flush
 *   then acquire invalidate+reload is self-consistent in data.
 * Gate NOT yet declared: n=3 with two race-free (SP=0) runs. Round 60
 * forces the race BOTH ways with a rendezvous and multiplies samples:
 *   R1: consumer writes READY(SLOT6), flushes, then polls doorbell
 *       (volatile + entire_all) — SP into SLOT5.
 *       producer FIRST polls READY (volatile + entire_all, PS into
 *       SLOT7), only then writes payload, flush, doorbell, flush.
 *       Both cores necessarily enter a spin loop under real race.
 * PASS(R1) x10 := SYNC_RC=0 AND OUT 1 1 7 8 AND SP<20000 AND PS<20000.
 * This is the P3 implementation prototype: release = store +
 * asc_dcci_entire_out + doorbell + flush; acquire = asc_dcci_entire_all
 * + volatile load loop. ffts/event_t investigation continues in the
 * background (CrossCoreSetFlag template lives in matmul kfc headers;
 * __builtin_cce_set_intra_block exists; event_t home still unmapped).
 * Shared GM buffer, 1024 B, host-zeroed, one 128B line per slot
 * (slot w-index = 32*i):
 *   w[0] payload(1u)   w[32] observed   w[64] completion(7u)
 *   w[96] entry mark(8u)  w[128] doorbell(1u)  w[160] consumer spins
 *   w[192] READY(1u)      w[224] producer spins
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

#define SLOT0 0u
#define SLOT1 32u
#define SLOT2 64u
#define SLOT3 96u
#define SLOT4 128u
#define SLOT5 160u
#define SLOT6 192u
#define SLOT7 224u
#define SPIN_MAX 20000u

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
#ifdef R1
    volatile __gm__ uint32_t *q = p;
    uint32_t pspins = 0;
    while (pspins < SPIN_MAX && q[SLOT6] != 1u) {
      asc_dcci_entire_all();
      ++pspins;
    }
    p[SLOT0] = 1u;
    asc_dcci_entire_out();
    p[SLOT4] = 1u;
    asc_dcci_entire_out();
    p[SLOT7] = pspins;
    asc_dcci_entire_out();
#else
    p[SLOT0] = 1u;
    asc_dcci_entire_out();
#endif
  } else {
    p[SLOT3] = 8u;
    asc_dcci_entire_out();
#ifdef R1
    p[SLOT6] = 1u;
    asc_dcci_entire_out();
    volatile __gm__ uint32_t *q = p;
    uint32_t spins = 0;
    while (spins < SPIN_MAX && q[SLOT4] != 1u) {
      asc_dcci_entire_all();
      ++spins;
    }
    p[SLOT1] = q[SLOT0];
    p[SLOT2] = 7u;
    p[SLOT5] = spins;
    asc_dcci_entire_out();
#else
    p[SLOT1] = p[SLOT0];
    p[SLOT2] = 7u;
    asc_dcci_entire_out();
#endif
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 1024, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 1024, 0, 1024) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t w[256];
  for (int i = 0; i < 256; ++i) w[i] = 9u;
  int mr = aclrtMemcpy(w, 1024, d, 1024, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("OUT %u %u %u %u\n", w[0], w[32], w[64], w[96]);
  printf("DL %u SP %u PS %u\n", w[128], w[160], w[224]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
