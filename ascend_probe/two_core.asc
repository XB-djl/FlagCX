/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * deliberately outside every build target and outside the device gate
 * Makefile, so it cannot affect CI or libflagcx.
 *
 * Round-52 measured: all three fence variants built (device+host+link)
 * RC=0 but every run ended SYNC_FAIL + "OUT 1 0 0 0", fast, no host
 * timeout. Round-53 measured (this file's predecessor):
 *   - V0 control (two blocks, NO arrive/wait): SYNC_RC=0 x3, consumer
 *     ran to completion x3 (p[2]=7, p[3]=8). So plain <<<2>>> DOES place
 *     two blocks on two live AI cores concurrently.
 *   - V0 run 3 returned "OUT 1 0 7 8": the consumer read the STALE p[0].
 *     A measured cross-core race on real hardware — ordering is required,
 *     not theoretical.
 *   - V1/V2/V3 (any fence): SYNC_RC=507015, "fftsplus aicore error",
 *     subErrType 4, "The scalar instruction accesses an invalid GM
 *     address or the cross-device memory access times out". Fault pc is
 *     start+0x84..0xbc on cores tagged blk:0 — the PRODUCER, whose only
 *     extra instruction vs V0 is asc_sync_block_arrive. The arrive
 *     itself faults; the consumer never gets to run.
 *   - aclrtLaunchCooperativeKernel: grep of $T/include/acl returned
 *     nothing and both coop builds failed with "use of undeclared
 *     identifier" — this toolkit has no cooperative launch at all.
 *     (My r53 harness also had a bug: the p[3] entry marker was stored
 *     before the wait but only flushed after it, so "p[3]=0" could not
 *     prove the consumer never ran. Fixed here: flush right after the
 *     marker, before any sync op.)
 * Round-54 question: is the fault in the block_arrive/block_wait
 * ENCODING (macros with no target routing) or in cube-side events as a
 * class? The 3-arg family asc_sync_notify(pipe,tpipe,id)/asc_sync_wait
 * has explicit routing and exists for both arches (round-51/53 survey).
 * Variants:
 *   C0 control   = round-53 V0 (known-good: proves rig still healthy).
 *   F1 signal    : core0 store;flush;notify(PIPE_M,PIPE_M,1).
 *                  core1 mark;flush;wait(PIPE_M,PIPE_M,1);invalidate;load.
 *   F3 negative  : core1 waits with NOTHING ever setting the flag.
 *                  A wait that "passes" here is a dead flag and would
 *                  make any F1 green meaningless — F3 calibrates what
 *                  block_wait does when unanswered.
 * Reading (PASS := SYNC_RC=0 AND OUT 1 1 7 8):
 *   C0 pass (expected), F3 faults fast fftsplus, F1 PASS -> notify/wait
 *      is the working cross-core spelling; block_arrive/wait is broken
 *      encoding only.
 *   F1 faults at producer pc near start -> notify also illegal cube-side
 *      -> events are vector-side on 2201: escalate to the SIMT/vector
 *      path or fall back to a polled GM flag design.
 *   F1 faults at consumer (blk:1) while producer completes -> wait/wait
 *      arity mismatch; read the sync_impl survey below for operand
 *      encoding and retry with corrected (pipe,tpipe,id).
 *   F3 PASSes (SYNC_RC=0) -> block_wait is a no-op when unanswered:
 *      any "green" from flag-based sync is untrustworthy on this build;
 *      prefer polled-flag + hardware dcci.
 * Shared GM buffer, 16 B, host-zeroed before launch:
 *   p[0] producer payload (1u)      p[1] consumer's observed value
 *   p[2] consumer completion (7u)   p[3] consumer entry marker (8u)
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
    p[0] = 1u;
    asc_dcci_entire_out();
#ifdef F1
    asc_sync_notify(PIPE_M, PIPE_M, 1);
#endif
  } else {
    p[3] = 8u;
    asc_dcci_entire_out();
#ifdef F1
    asc_sync_wait(PIPE_M, PIPE_M, 1);
    asc_dcci_entire_all();
#elif defined(F3)
    asc_sync_block_wait(PIPE_M, 1);
    asc_dcci_entire_all();
#endif
    p[1] = p[0];
    p[2] = 7u;
    asc_dcci_entire_out();
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 16, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 16, 0, 16) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t h[4] = {9u, 9u, 9u, 9u};
  int mr = aclrtMemcpy(h, 16, d, 16, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("OUT %u %u %u %u\n", h[0], h[1], h[2], h[3]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
