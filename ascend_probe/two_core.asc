/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * outside every build target and the device gate Makefile.
 *
 * Round-56 measured (per-cache-line slots fixed the rig):
 *   - C0 3/3 SYNC_RC=0 AND OUT 1 1 7 8 — baseline trustworthy at last;
 *     r55's flicker was line trampling, confirmed.
 *   - F3 124 x3: wait_flag_dev (via asc_sync_block_wait) really blocks.
 *   - F1 507015 x3 but with FULL OUT 1 1 7 8 each time (faults recorded
 *     on blk:0 once, blk:1 twice, pc in the AIV range 0x1240000000a4):
 *     the store path runs to completion on the cube side, only the ffts
 *     event instruction is illegal — and the 3-arg asc_sync_wait did
 *     NOT block the consumer. Two waits, two behaviors: wait_flag_dev
 *     waits; wait_flag(pipe,tpipe,raw-id) with the wrong-typed id does
 *     nothing anyone can rely on. F1's 1 1 7 8 is NOT a sync success —
 *     C0 shows the same without any wait. Gate remains UNMET.
 *   - Impl bodies read: block_arrive = ffts_cross_core_sync(pipe,
 *     GetfftsConfig(flag)) with mode hardcoded 0x02, flag masked to 4
 *     bits; notify = set_flag(pipe,tpipe,id); wait = wait_flag(...) —
 *     all defined in utils_impl/utils_impl.h, NOT yet dumped (and the
 *     event_t grep came back empty because $T/include/c_api does not
 *     exist — r48's lesson: -I was always decorative, bisheng's builtin
 *     search path serves the headers from asc/include).
 * Round 57 measured: BOTH poll variants failed identically —
 *   P1 (asc_dcci_single per spin) and P2 (no invalidate): 6/6 runs
 *   SYNC_RC=0, final GM DL=1, but SP=20000 every time: the consumer
 *   NEVER observed the doorbell during the poll, and single-line
 *   invalidation changed nothing vs no invalidation at all. The
 *   payload=1 in OUT is a post-bound cold read (same as C0), not
 *   synchronization. GM polling as designed cannot carry acquire.
 * Round 57 also found the official spelling inside the toolkit:
 * asc_pipe_barrier_impl.h uses set_flag(pipe_t::PIPE_MTE2,
 * pipe_t::PIPE_V, static_cast<event_t>(id)) — pipe_t members and a
 * real event_t cast (exactly what -Wcce-compat demanded);
 * ffts_cross_core_sync has no declaration in either tree (bisheng
 * builtin intrinsic); sync.h 2201 branch additionally exposes
 * asc_sync_inter_wait -> wait_flag_dev(flagID).
 * Round 58: one last polling form before that line is closed —
 *   H1: identical doorbell protocol, but the spin hammers
 *       asc_dcci_entire_all() (whole-L1 invalidate) every iteration.
 * Reading matrix: H1 PASS := SYNC_RC=0 AND SP<20000 (doorbell seen).
 * H1 also SP=20000 => polling is definitively dead and ffts/event_t
 * (dumped this same round) is the sole route to the P3 gate.
 * C0 stays in every round as the baseline. P1/P2/F1/F3 retired:
 * signatures pinned across r55-r57.
 * Shared GM buffer, 1024 B, host-zeroed, one 128B line per slot
 * (slot w-index = 32*i):
 *   w[0] payload(1u)   w[32] observed   w[64] completion(7u)
 *   w[96] entry mark(8u)  w[128] doorbell(1u)  w[160] spin count
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

#define SLOT0 0u
#define SLOT1 32u
#define SLOT2 64u
#define SLOT3 96u
#define SLOT4 128u
#define SLOT5 160u
#define SPIN_MAX 20000u

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
    p[SLOT0] = 1u;
    asc_dcci_entire_out();
#ifdef H1
    p[SLOT4] = 1u;
    asc_dcci_entire_out();
#endif
  } else {
    p[SLOT3] = 8u;
    asc_dcci_entire_out();
#ifdef H1
    uint32_t spins = 0;
    while (spins < SPIN_MAX && p[SLOT4] != 1u) {
      asc_dcci_entire_all();
      ++spins;
    }
    asc_dcci_entire_all();
    p[SLOT1] = p[SLOT0];
    p[SLOT2] = 7u;
    p[SLOT5] = spins;
    asc_dcci_entire_out();
#else
    p[SLOT1] = p[SLOT0];
    p[SLOT2] = 7u;
    asc_dcci_entire_out();
#endif
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 1024, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 1024, 0, 1024) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t w[256];
  for (int i = 0; i < 256; ++i) w[i] = 9u;
  int mr = aclrtMemcpy(w, 1024, d, 1024, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("OUT %u %u %u %u\n", w[0], w[32], w[64], w[96]);
  printf("DL %u SP %u\n", w[128], w[160]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
