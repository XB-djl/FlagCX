/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C two-core producer/consumer round trip — the P3 ordering gate.
 * Standalone bisheng rig (ascend_probe/build_run.sh compiles and runs it);
 * deliberately outside every build target and outside the device gate
 * Makefile, so it cannot affect CI or libflagcx.
 *
 * What is measured here, and only this: whether a store made by one AI
 * core, followed by the release spelling (asc_dcci_entire_out +
 * asc_sync_block_arrive), is OBSERVED by a second core running the acquire
 * spelling (asc_sync_block_wait + asc_dcci_entire_all) before it reads.
 * Rounds 48-51 proved EMISSION (RC=0 through -c); emission is not
 * ordering. PASS = "OUT 1 1 7 0" from every run of the chosen variant.
 *
 * Variants (one -D each, same source, all built and run by the script):
 *   V1 (no -D beyond it) signal shape:
 *        core0: store; flush; arrive(ev1).
 *        core1: wait(ev1); invalidate; load.
 *        (2201 spelling from the header survey, round 51:
 *         asc_sync_block_wait(pipe, flag) expands to wait_flag_dev(flag),
 *         the pipe argument is dropped on this arch.)
 *   V2 barrier-safe shape: core1 ALSO arrive(ev1) before its wait — the
 *        only shape that survives counted-barrier semantics.
 *   V3 = V1 with both dcci calls removed — isolates whether the cache
 *        ops are load-bearing for visibility or the flag alone orders.
 * Reading the outcomes:
 *   V1 PASS x3                  -> flag is signal-shaped; see V3.
 *   V1 timeout(124), V2 PASS    -> counted-barrier flag; V2 is the
 *                                  production shape.
 *   V2 returns OUT 1 0 7 0      -> signal flag + self-arrival race: V1
 *                                  is the correct shape (b1's own arrive
 *                                  released its wait early).
 *   V1 PASS, V3 FAIL            -> dcci is required: keep both sides.
 *   all 124                     -> two blocks were not co-resident or
 *                                  the event never fires: escalate to
 *                                  asc_sync_notify/wait(pipe,tpipe,id).
 *
 * Shared GM buffer, 16 B, host-zeroed before launch:
 *   p[0] producer payload (stored 1u)   p[1] consumer's observed value
 *   p[2] consumer completion marker 7u  p[3] untouched sentinel (expect 0)
 *
 * Every shape below is a reuse of an on-record measurement, not an
 * assumption: __gm__ kernel pointer parameter accepted at the launch
 * boundary with an unqualified host pointer (probes B5/RG); the
 * <<<blocks, (void*)0, 0>>> launch and the aclrtMalloc/
 * ACL_MEM_MALLOC_HUGE_FIRST + aclrtMemcpy ACL_MEMCPY_DEVICE_TO_HOST
 * readback are the RP/RG harness verbatim (those printed "OUT 10 11 0 0"
 * and "OUT 20 22 0 0" in execution); asc_get_block_idx() and
 * asc_get_block_num() from c_api/sys_var/sys_var.h (round-51 survey);
 * the dcci and FFTS spellings measured RC=0 in rounds 48-50.
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

extern "C" __global__ __aicore__ void t2c(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  if (b == 0) {
    p[0] = 1u;
#ifndef V3
    asc_dcci_entire_out();
#endif
    asc_sync_block_arrive(PIPE_M, 1);
  } else {
#ifdef V2
    asc_sync_block_arrive(PIPE_M, 1);
#endif
    asc_sync_block_wait(PIPE_M, 1);
#ifndef V3
    asc_dcci_entire_all();
#endif
    p[1] = p[0];
    p[2] = 7u;
  }
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 16, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 16, 0, 16) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  t2c<<<2, (void *)0, 0>>>((uint32_t *)d);
  if (aclrtSynchronizeStream((aclrtStream)0) != 0) {
    printf("SYNC_FAIL\n");
  }
  uint32_t h[4] = {9u, 9u, 9u, 9u};
  if (aclrtMemcpy(h, 16, d, 16, ACL_MEMCPY_DEVICE_TO_HOST) != 0) {
    printf("CP_FAIL\n");
  }
  printf("OUT %u %u %u %u\n", h[0], h[1], h[2], h[3]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
