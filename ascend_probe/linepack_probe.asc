/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Ascend 910C release-pair ordering - round 69 probe (linepack).
 * r68 measured the GM barrier failing its pre-registered check: 4/10
 * runs showed V>0, ALWAYS on core0 (the long waiter, S up to 441) about
 * core1 (the racer, S<=6): a seen arrival line with a stale work line.
 * Hypothesis (NOT yet a fact): two back-to-back release pairs
 * (store A + entire_out; store B + entire_out) let B land in GM before
 * A has finished flushing - a "doorbell before parcel" window that the
 * 40/40 one-shot rendezvous simply never entered (long wait = settle
 * time). This probe decides which of three worlds we live in.
 *
 * One kernel, two layouts, same accounting:
 *   OLD arm (-DLP_OLD): r68 layout, work and arrival on SEPARATE lines,
 *     two release pairs - expected to reproduce the window, this time
 *     at 100 rounds for density.
 *   LP  arm (default): arrival and work are ADJACENT WORDS OF ONE LINE
 *     (word0 = arrival round, word1 = work), ONE store burst + ONE
 *     entire_out per release. If a flush moves its line as a unit
 *     (>= 8B sector covers both words), a split here is impossible.
 *   Bounded verify on any split sighting: hammer (entire_all) + reread
 *     the work word up to 50 times. recovered -> settled; still stale
 *     after 50 rounds of refetches -> VIO (in-flight is NOT finite =
 *     structural failure).
 * Counters per core, one stats line each:
 *   F degrades (spin exhaustion, never deadlock), S max spins,
 *   R splits sighted, V splits that never settled within 50 refetches.
 * Arrival is monotonic (round number, >= wait), so a peer ahead can
 * only make work read HIGH, never a false split; verify rereads only
 * the work word for that reason.
 * Output: "L3 F u u S u u V u u R u u" (core0 first), SYNC_RC line.
 *
 * PASS matrix, PRE-REGISTERED before any run (2026-11-11, from r68
 * density ~8 splits / 200 rounds => expect ~40 splits / 2000 rounds):
 *   OLD x10 : F 0 0, S0>>S1 asymmetry reproduces, R>0 in >=7/10,
 *             AND V=0 10/10  => window is a finite in-flight effect,
 *             settle time bounded (this is the boring fix world).
 *   LP  x10 : F 0 0, V=0 10/10, AND R=0 in every run => one-line
 *             one-release publish is indivisible => sound primitive
 *             for the barrier AND for T2 FIFO rings (pack flag with
 *             payload). R>0 with V=0 => line still splits but always
 *             settles => verify protocol is the primitive, packing
 *             alone is not. V>0 ANYWHERE => GM/dcci ordering is
 *             structurally unsound at flush granularity: namedBarrier-
 *             Sync stays declared-absent permanently AND the shipped
 *             channel wording must be narrowed to single-shot publish
 *             (the 40/40 and 10/10 one-shot facts stay true).
 * Any non-zero SYNC_RC, a timeout EXIT line, or a shape not listed
 * above: record verbatim, no averaging.
 ************************************************************************/
#include <stdint.h>
#include <stdio.h>
#include <acl/acl.h>
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"

#define NROUNDS 100u
#define SPIN_MAX 20000u
#define VERIFY_MAX 50u

extern "C" __global__ __aicore__ void bar3(__gm__ uint32_t *p) {
  const int64_t b = asc_get_block_idx();
  const uint32_t AS = (b == 0) ? 0u : 32u;   /* own arrival word  */
  const uint32_t PA = (b == 0) ? 32u : 0u;   /* peer arrival word */
#ifdef LP_OLD
  const uint32_t WS = (b == 0) ? 64u : 96u;  /* own work line     */
  const uint32_t PW = (b == 0) ? 96u : 64u;  /* peer work line    */
#else
  const uint32_t WS = AS + 1u;               /* same line, word1  */
  const uint32_t PW = PA + 1u;
#endif
  const uint32_t ST = (b == 0) ? 128u : 160u; /* F S V R          */
  volatile __gm__ uint32_t *q = p;
  uint32_t deg = 0, mx = 0, vio = 0, ret = 0;
  for (uint32_t r = 1u; r <= NROUNDS; ++r) {
#ifdef LP_OLD
    p[WS] = r;
    asc_dcci_entire_out();
    p[AS] = r;
    asc_dcci_entire_out();
#else
    p[WS] = r;
    p[AS] = r;
    asc_dcci_entire_out();
#endif
    uint32_t sp = 0;
    while (sp < SPIN_MAX && q[PA] < r) {
      asc_dcci_entire_all();
      ++sp;
    }
    if (sp >= SPIN_MAX) {
      ++deg;
      if (sp > mx) mx = sp;
      continue;
    }
    if (sp > mx) mx = sp;
    uint32_t w = q[PW];
    if (w < r) {                 /* split sighted: arrival seen, work stale */
      ++ret;
      uint32_t vs = 0;
      while (vs < VERIFY_MAX) {
        asc_dcci_entire_all();
        w = q[PW];
        ++vs;
        if (w >= r) break;
      }
      if (w < r) ++vio;          /* not settled in 50 refetches = structural */
    }
  }
  p[ST] = deg;
  p[ST + 1u] = mx;
  p[ST + 2u] = vio;
  p[ST + 3u] = ret;
  asc_dcci_entire_out();
}

int main() {
  if (aclInit(nullptr) != 0) { printf("ACLINIT_FAIL\n"); return 1; }
  if (aclrtSetDevice(0) != 0) { printf("SETDEV_FAIL\n"); return 1; }
  void *d = nullptr;
  if (aclrtMalloc(&d, 1536, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
    printf("MALLOC_FAIL\n");
    return 1;
  }
  if (aclrtMemset(d, 1536, 0, 1536) != 0) { printf("MEMSET_FAIL\n"); return 1; }
  bar3<<<2, (void *)0, 0>>>((uint32_t *)d);
  int sr = aclrtSynchronizeStream((aclrtStream)0);
  printf("SYNC_RC=%d\n", sr);
  if (sr != 0) printf("RECENT %s\n", aclGetRecentErrMsg());
  uint32_t w[384];
  for (int i = 0; i < 384; ++i) w[i] = 9u;
  int mr = aclrtMemcpy(w, 1536, d, 1536, ACL_MEMCPY_DEVICE_TO_HOST);
  if (mr != 0) printf("CP_RC=%d\n", mr);
  printf("L3 F %u %u S %u %u V %u %u R %u %u\n", w[128], w[160],
         w[129], w[161], w[130], w[162], w[131], w[163]);
  aclrtFree(d);
  aclrtResetDevice(0);
  aclFinalize();
  return 0;
}
