/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * cann-shmem MTE compare_swap probe, device side (F1) — Ascend 910C.
 *
 * Each PE runs a CAS increment loop: every iteration is one successful
 * compare_swap (old == current, advance by one) plus however many failed
 * probes contend with it.  The final word must equal iters * npes, which
 * proves both that CAS returns the previous value and that it serialises
 * concurrent updates.
 ************************************************************************/

#include <shmem.h>

#include "atom_args.h"

#if defined(__CCE_IS_AICORE__)
#include "gm2gm/shmem_device_cc.h"
#include "gm2gm/engine/shmem_device_mte.hpp"
#endif

#define ATOM_CAS_KERNEL(NAME, T)                                           \
  extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void      \
  NAME(AtomArgs a) {                                                       \
    util_set_ffts_config(a.ffts);                                          \
    __gm__ T *dst = (__gm__ T *)a.dst;                                     \
    T cur = (T)0;                                                          \
    for (int i = 0; i < a.iters; ++i) {                                    \
      for (;;) {                                                           \
        T old = aclshmemx_mte_atomic_compare_swap<T>(dst, cur, cur + (T)1, \
                                                     a.pe);                \
        if (old == cur) {                                                  \
          cur = cur + (T)1;                                                \
          break;                                                           \
        }                                                                  \
        cur = old;                                                         \
      }                                                                    \
    }                                                                      \
  }

ATOM_CAS_KERNEL(atomCasU32, uint32_t)
ATOM_CAS_KERNEL(atomCasU64, uint64_t)
ATOM_CAS_KERNEL(atomCasI32, int32_t)
ATOM_CAS_KERNEL(atomCasF32, float)

#if !defined(__CCE_IS_AICORE__)
#include <acl/acl.h>
#include "host/data_plane/shmem_host_p2p_sync.h"

extern "C" int atomLaunchCas(int type, aclrtStream stream,
                             unsigned long long dst, int pe, int iters,
                             int ncores) {
  AtomArgs a;
  a.ffts = util_get_ffts_config();
  a.dst = dst;
  a.pe = pe;
  a.iters = iters;
  switch (type) {
  case 0:
    atomCasU32<<<ncores, (void *)0, stream>>>(a);
    break;
  case 1:
    atomCasU64<<<ncores, (void *)0, stream>>>(a);
    break;
  case 2:
    atomCasI32<<<ncores, (void *)0, stream>>>(a);
    break;
  case 3:
    atomCasF32<<<ncores, (void *)0, stream>>>(a);
    break;
  default:
    return -1;
  }
  return 0;
}
#endif
