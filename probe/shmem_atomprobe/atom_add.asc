/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * cann-shmem MTE atomic add probe, device side (F1) — Ascend 910C.
 *
 * Kernels never poll: they post `iters` atomics into the symmetric word and
 * return.  The host judges the final value, so a missing engine completion
 * is a verdict (timeout) instead of a hung kernel.  The dst is the local
 * symmetric address; the engine translates it to `pe` (the pe argument
 * would be meaningless for a pre-translated pointer).
 ************************************************************************/

#include <shmem.h>

#include "atom_args.h"

#if defined(__CCE_IS_AICORE__)
#include "gm2gm/shmem_device_cc.h"
#include "gm2gm/engine/shmem_device_mte.hpp"
#endif

// core_ratio(0, 1) pins the kernel to vector cores: the cube core does not
// track MTE completion (measured as the S16 hang, see device_ir.asc).
#define ATOM_ADD_KERNEL(NAME, T)                                           \
  extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void      \
  NAME(AtomArgs a) {                                                       \
    util_set_ffts_config(a.ffts);                                          \
    __gm__ T *dst = (__gm__ T *)a.dst;                                     \
    for (int i = 0; i < a.iters; ++i)                                      \
      aclshmemx_mte_atomic_add<T>(dst, (T)1, a.pe);                        \
  }

ATOM_ADD_KERNEL(atomAddU32, uint32_t)
ATOM_ADD_KERNEL(atomAddU64, uint64_t)
ATOM_ADD_KERNEL(atomAddI32, int32_t)
ATOM_ADD_KERNEL(atomAddF32, float)

#if !defined(__CCE_IS_AICORE__)
#include <acl/acl.h>
#include "host/data_plane/shmem_host_p2p_sync.h"

extern "C" int atomLaunchAdd(int type, aclrtStream stream,
                             unsigned long long dst, int pe, int iters,
                             int ncores) {
  AtomArgs a;
  a.ffts = util_get_ffts_config();
  a.dst = dst;
  a.pe = pe;
  a.iters = iters;
  switch (type) {
  case 0:
    atomAddU32<<<ncores, (void *)0, stream>>>(a);
    break;
  case 1:
    atomAddU64<<<ncores, (void *)0, stream>>>(a);
    break;
  case 2:
    atomAddI32<<<ncores, (void *)0, stream>>>(a);
    break;
  case 3:
    atomAddF32<<<ncores, (void *)0, stream>>>(a);
    break;
  default:
    return -1;
  }
  return 0;
}
#endif
