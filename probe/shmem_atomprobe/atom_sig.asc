/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * cann-shmem signal ADD probe, device side (F1) — Ascend 910C.
 *
 * The vendor docs say signal SET is not atomic and ADD is; this unit puts
 * that on the record: every PE issues `iters` ADD signals into PE0's
 * int32 word, which must end at iters * npes.  The signal API is int32 by
 * declaration — that limit is why the backend's ticket scheme exists.
 ************************************************************************/

#include <shmem.h>

#include "atom_args.h"

#if defined(__CCE_IS_AICORE__)
#include "gm2gm/shmem_device_cc.h"
#include "gm2gm/shmem_device_p2p_sync.h"
#endif

extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void
atomSigAdd(AtomArgs a) {
  util_set_ffts_config(a.ffts);
  __gm__ int32_t *sig = (__gm__ int32_t *)a.dst;
  for (int i = 0; i < a.iters; ++i)
    aclshmemx_signal_op(sig, 1, ACLSHMEM_SIGNAL_ADD, a.pe);
}

#if !defined(__CCE_IS_AICORE__)
#include <acl/acl.h>
#include "host/data_plane/shmem_host_p2p_sync.h"

extern "C" int atomLaunchSig(aclrtStream stream, unsigned long long dst,
                             int pe, int iters) {
  AtomArgs a;
  a.ffts = util_get_ffts_config();
  a.dst = dst;
  a.pe = pe;
  a.iters = iters;
  atomSigAdd<<<1, (void *)0, stream>>>(a);
  return 0;
}
#endif
